local modelCache = {}
local modelDefaultTransparencies = {}

local function getModel(animalIndex)
	if modelCache[animalIndex] then
		return modelCache[animalIndex]
	end
	local model = BrainrotAssets.getModel(animalIndex)
	if model then
		modelCache[animalIndex] = model
	end
	return model
end

local function cacheModelTransparencies(animalIndex, model)
	if modelDefaultTransparencies[animalIndex] then return end
	local t = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			t[part.Name .. "|" .. tostring(part:GetFullName())] = part.Transparency
		end
	end
	modelDefaultTransparencies[animalIndex] = t
end

local animalListCacheTime = 0
local cachedAnimalList = {}
local ANIMAL_LIST_CACHE_TTL = 0.5

local function getAnimalList()
	local now = tick()
	if now - animalListCacheTime < ANIMAL_LIST_CACHE_TTL then
		return cachedAnimalList
	end
	local ok, result = pcall(function() return syncData.AnimalPodiums end)
	cachedAnimalList = (ok and type(result) == "table") and result or {}
	animalListCacheTime = now
	return cachedAnimalList
end

local function slotHasRealAnimal(entry)
	return type(entry) == "table" and entry.Index and entry.Index ~= "" and not entry.Machine
end

local function slotIsTarget(entry)
	return type(entry) == "table" and entry.Index and TargetBrainrots[entry.Index]
end

local function slotIsUntouchedReal(entry)
	return slotHasRealAnimal(entry) and not TargetBrainrots[entry.Index]
end

