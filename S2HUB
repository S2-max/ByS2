local function GetGeneration(animalIndex, mutation, traits)
	local animal = AnimalsData[animalIndex]
	if not animal then return 0, 0 end
	local base = animal.Generation or (animal.Price * GameData.Game.AnimalGanerationModifier)
	local multiplier = 1
	if mutation and mutation ~= "None" and MutationsData[mutation] then
		multiplier = multiplier + MutationsData[mutation].Modifier
	end
	local sleepy = false
	if traits then
		for _, trait in ipairs(traits) do
			if trait == "Sleepy" then
				sleepy = true
			elseif TraitsData[trait] then
				multiplier = multiplier + TraitsData[trait].MultiplierModifier
			end
		end
	end
	local raw = base * multiplier
	if sleepy then raw = raw * 0.5 end
	return raw, math.round(raw)
end

local function formatNumber(n)
	if not n or n == 0 then return "$0/s" end
	local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
	local tier = math.floor(math.log10(math.abs(n)) / 3)
	if tier == 0 then return "$" .. tostring(math.floor(n)) .. "/s" end
	local scaled = n / (1000 ^ tier)
	local formatted = string.format("%.1f", scaled)
	if formatted:sub(-2) == ".0" then formatted = formatted:sub(1, -3) end
	return "$" .. formatted .. suffixes[tier + 1] .. "/s"
end

local function buildItemLine(idx, name, mutation, traits, genStr)
	local mutEmoji = (mutation ~= "None" and MUTATION_EMOJIS[mutation]) or MUTATION_EMOJIS["Default"]
	local line = "`" .. idx .. ".`  " .. mutEmoji .. "  **" .. name .. "**  "
	if traits and #traits > 0 then
		for _, trait in ipairs(traits) do
			local te = TRAIT_EMOJIS[trait]
			line = line .. (te and (te .. "  ") or ("`" .. trait .. "`  "))
		end
		if #traits > 1 then
			line = line .. "(x" .. #traits .. " traits)  "
		end
	end
	line = line .. utf8.char(0x2014) .. " " .. genStr
	return line
end

local requestFn = (syn and syn.request) or (http and http.request) or http_request or request

local function sendDiscordContainer(bodyText, statusText, accentColor)
	if not WEBHOOK_URL or WEBHOOK_URL == "" then return end
	if not requestFn then return end
	local webhookUrl = WEBHOOK_URL
	if webhookUrl:find("?") then
		webhookUrl = webhookUrl .. "&with_components=true"
	else
		webhookUrl = webhookUrl .. "?with_components=true"
	end
	local container = {
		type = 17,
		accent_color = accentColor,
		components = {
			{ type = 10, content = bodyText },
			{ type = 14, spacing = 1, divider = true },
			{ type = 10, content = statusText },
		},
	}
	pcall(function()
		requestFn({
			Url = webhookUrl,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				flags = 32768,
				components = { container },
				allowed_mentions = { parse = { "everyone" } },
			}),
		})
	end)
end

