local function cleanPodiumSlot(targetSlot)
	local podiums = myPlotModel:FindFirstChild("AnimalPodiums")
	if not podiums then return end
	local podium = podiums:FindFirstChild(tostring(targetSlot))
	if not podium then return end
	for _, desc in ipairs(podium:GetDescendants()) do
		if (desc:IsA("Attachment") or desc:IsA("TouchTransmitter")) and desc.Name ~= "PromptAttachment" then
			pcall(function() desc:Destroy() end)
		end
	end
	for _, desc in ipairs(podium:GetDescendants()) do
		if desc.Name == "PromptAttachment" then
			for _, child in ipairs(desc:GetChildren()) do
				child:Destroy()
			end
		end
	end
	local claimPart = podium:FindFirstChild("Claim")
	if claimPart then
		for _, desc in ipairs(claimPart:GetDescendants()) do
			if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") or desc:IsA("TouchTransmitter") then
				pcall(function() desc:Destroy() end)
			end
		end
		local hitbox = claimPart:FindFirstChild("Hitbox")
		if hitbox then
			local ti = hitbox:FindFirstChildOfClass("TouchTransmitter")
			if ti then pcall(function() ti:Destroy() end) end
		end
	end
end

local function restoreModelTransparency(cloneModel, animalIndex)
	local template = modelCache[animalIndex]
	if not template then
		for _, part in cloneModel:GetDescendants() do
			if part:IsA("BasePart") then
				local stored = part:GetAttribute("DefaultTransparency")
				if stored ~= nil then
					part.Transparency = stored
				end
			end
		end
		return
	end
	local templateParts = {}
	for _, part in template:GetDescendants() do
		if part:IsA("BasePart") then
			templateParts[part.Name] = part.Transparency
		end
	end
	for _, part in cloneModel:GetDescendants() do
		if part:IsA("BasePart") then
			local tval = templateParts[part.Name]
			if tval ~= nil then
				part.Transparency = tval
				part:SetAttribute("DefaultTransparency", tval)
			else
				local stored = part:GetAttribute("DefaultTransparency")
				if stored ~= nil then
					part.Transparency = stored
				end
			end
		end
	end
end

