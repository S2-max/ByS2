    local function callRemote(remoteType, uuid, ...)
        local remote = Remotes[remoteType]
        if not remote then
            return nil
        end
        
        local args = {...}
        
        if typeof(remote) == "Instance" then
            if remote:IsA("RemoteFunction") then
                local success, result = pcall(function()
                    return remote:InvokeServer(uuid, table.unpack(args))
                end)
                if not success then
                    return nil
                end
                return result
            elseif remote:IsA("RemoteEvent") then
                local success, err = pcall(function()
                    remote:FireServer(uuid, table.unpack(args))
                end)
                if not success then
                    return nil
                end
                return true
            end
        end
        
        if type(remote) == "function" then
            local success, result = pcall(function()
                return remote(uuid, table.unpack(args))
            end)
            if not success then
                return nil
            end
            return result
        end
        
        return nil
    end

