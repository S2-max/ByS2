local function DoMoney(val)
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
	local cashout = PlayerGui.LeftBottom.LeftBottom.Cashout
	local template = cashout.Template
	local tweenInfo = TweenInfo.new(5, Enum.EasingStyle.Linear)
	fakeVal += val
	local clone = template:Clone()
	clone.Text = ("%s$%s"):format(val > 0 and "+" or "-", NumberUtils:ToString(math.abs(val), 2))
	clone.TextColor3 = val < 0 and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(13, 255, 0)
	clone.Visible = true
	clone.Parent = cashout
	local tween1 = TweenService:Create(clone, tweenInfo, { TextTransparency = 1 })
	local tween2 = TweenService:Create(clone.UIStroke, tweenInfo, { Transparency = 1 })
	tween1.Completed:Once(function() clone:Destroy() end)
	tween1:Play()
	tween2:Play()
	if val > 0 then MoneySound() end
end

local function getMultiplier()
	local ok, text = pcall(function()
		return myPlotModel.Multiplier.Main.Amount.ContentText
	end)
	if not ok or not text then return 1 end
	local clean = text:gsub("[^%d%.%,]", ""):gsub(",", ".")
	return tonumber(clean) or 1
end

local function getMaxSlots()
	local tier = myPlotModel:GetAttribute("Tier") or 0
	local baseData = BasesData[tier]
	if baseData and baseData.MaxAnimals then return baseData.MaxAnimals end
	local podiums = myPlotModel:FindFirstChild("AnimalPodiums")
	if not podiums then return 20 end
	local count = 0
	for _, c in ipairs(podiums:GetChildren()) do
