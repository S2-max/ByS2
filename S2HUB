local spawnAnimalOnPlot

spawnAnimalOnPlot = function(animalIndex, mutation, traits, targetSlot)
	local animalData = AnimalsData[animalIndex]
	if not animalData then return false end

	local modelTemplate = getModel(animalIndex)
	if not modelTemplate then return false end

	cacheModelTransparencies(animalIndex, modelTemplate)

	if fakeCollectors[targetSlot] then
		fakeCollectors[targetSlot]:Clean()
		fakeCollectors[targetSlot] = nil
		fakeAnimalData[targetSlot] = nil
	end

	cleanPodiumSlot(targetSlot)
	clearActiveEmptyPrompts(targetSlot)

	local collector = Trove.new()
	fakeCollectors[targetSlot] = collector

	local genValue = select(2, GetGeneration(animalIndex, mutation, traits))
	local resolvedDisplayName = getDisplayName(animalIndex)

	fakeAnimalData[targetSlot] = {
		Index = animalIndex,
		DisplayName = resolvedDisplayName,
		Mutation = mutation,
		Traits = traits,
		Cash = "$" .. NumberUtils:ToString(genValue) .. "/s",
		IsFake = true,
	}

	local cloneModel = modelTemplate:Clone()
	collector:Add(cloneModel)

	for _, part in cloneModel:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			part:SetAttribute("DefaultTransparency", part.Transparency)
		end
	end

	if cloneModel.PrimaryPart then
		cloneModel.PrimaryPart.Anchored = true
	end

	local realScale = cloneModel:GetScale()

	if mutation then
		collector:Add(SharedAnimals:ApplyMutation(cloneModel, animalIndex, mutation))
		cloneModel:SetAttribute("Mutation", mutation)
	end

	local extents = cloneModel:GetExtentsSize()

	if traits and #traits > 0 then
		collector:Add(SharedAnimals:ApplyTraits(cloneModel, animalIndex, traits))
		cloneModel:SetAttribute("Traits", table.concat(traits, ","))
	end

	local podiums = myPlotModel:FindFirstChild("AnimalPodiums")
	local podium = podiums and podiums:FindFirstChild(tostring(targetSlot))
	if not podium then
		collector:Clean()
		fakeCollectors[targetSlot] = nil
		fakeAnimalData[targetSlot] = nil
		return false
	end

	local spawnPart = podium.Base.Spawn
	local spawnPivot = spawnPart:GetPivot()

	cloneModel:ScaleTo(realScale)
	cloneModel.Parent = myPlotModel
	cloneModel:PivotTo(spawnPivot)

	restoreModelTransparency(cloneModel, animalIndex)

	do
		local existing = cloneModel:FindFirstChild("AnimationController")
		if existing then existing:Destroy() end
		local hum = collector:Add(Instance.new("Humanoid", cloneModel))
		Instance.new("Animator", hum)
		hum.Name = "AnimationController"
		hum.EvaluateStateMachine = false
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.PlatformStand = true
		local anim = hum:FindFirstChildOfClass("Animator")
		local animFolderEntry = AnimFolder:FindFirstChild(animalIndex)
		local idleAnim = animFolderEntry and animFolderEntry:FindFirstChild("Idle")
		if idleAnim and anim then
			local track = anim:LoadAnimation(idleAnim)
			track.Looped = true
			track:Play()
			local unsync = AnimSync:Add(track)
			collector:Add(function()
				unsync()
				track:Stop(0)
				track:Destroy()
			end)
		end
	end

	local overhead
	do
		local rarityEntry = RaritiesData[animalData.Rarity]
		local priceValue = animalData.Price
		local genVal = select(2, GetGeneration(animalIndex, mutation, traits))

		local existingAttach = cloneModel:FindFirstChild("OVERHEAD_ATTACHMENT", true)
		local attach
		if existingAttach then
			attach = existingAttach
		else
			attach = collector:Add(Instance.new("Attachment"))
			attach.Name = "Attachment"
			attach.CFrame = CFrame.new(0, extents.Y * 0.75, 0)
			attach.Parent = spawnPart
		end

		local cleanOH
		overhead, cleanOH = FastOverhead.createFastOverhead({
			adornee = attach,
			guiTemplate = FastOverhead.GuiTemplates.AnimalOverhead,
		})
		collector:Add(cleanOH)

		local overheadDisplayName = resolvedDisplayName
		if traits and #traits > 0 then
			for _, traitName in ipairs(traits) do
				local traitData = TraitsData[traitName]
				if traitData and traitData.OverheadDisplayName then
					local ok, result = pcall(traitData.OverheadDisplayName, resolvedDisplayName)
					if ok and result then overheadDisplayName = result; break end
				end
			end
		end

		overhead.DisplayName.Text = overheadDisplayName
		overhead.Price.Text = ("$%s"):format(NumberUtils:ToString(priceValue))
		overhead.Rarity.Text = animalData.Rarity
		overhead.Rarity.TextColor3 = rarityEntry and rarityEntry.Color or rarityColor(animalData.Rarity)
		overhead.Mutation.Visible = mutation ~= nil

		if mutation and MutationsData[mutation] then
			local mutData = MutationsData[mutation]
			if mutData.UseRichText then
				overhead.Mutation.Text = mutData.DisplayWithRichText
				overhead.Mutation.RichText = true
			else
				overhead.Mutation.Text = mutData.DisplayText or tostring(mutation)
			end
			if mutData.GradientPreset then
				overhead.Mutation.TextColor3 = Color3.fromRGB(255, 255, 255)
				collector:Add(Gradients.apply(overhead.Mutation, mutData.GradientPreset))
			else
				overhead.Mutation.TextColor3 = mutData.MainColor or Color3.fromRGB(255, 255, 255)
			end
		end

		if rarityEntry and rarityEntry.StrokeColor then
			local stroke = overhead.Rarity:FindFirstChildOfClass("UIStroke")
			if stroke then stroke.Color = rarityEntry.StrokeColor end
		end

		if rarityEntry and rarityEntry.GradientPreset then
			collector:Add(Gradients.apply(overhead.Rarity, rarityEntry.GradientPreset))
		end

		local gen = overhead:FindFirstChild("Generation")
		if gen then
			gen.Text = ("$%s/s"):format(NumberUtils:ToString(genVal))
			gen.Visible = true
		end

		local traitsFrame = overhead:FindFirstChild("Traits")
		if traitsFrame then
			if traits and #traits > 0 then
				local tmpl = traitsFrame:FindFirstChild("Template")
				for _, traitName in traits do
					local traitData = TraitsData[traitName]
					if traitData and tmpl then
						local icon = collector:Add(tmpl:Clone())
						icon.Image = traitData.Icon
						icon.Visible = true
						icon.Parent = traitsFrame
					end
				end
				traitsFrame.Visible = true
			else
				traitsFrame.Visible = false
			end
		end
	end

	local collectLabel = nil
	local syncEntry = getAnimalList()[targetSlot]
	local collectedAt = (type(syncEntry) == "table" and syncEntry.LastCollect) and syncEntry.LastCollect or Workspace:GetServerTimeNow()
	local lastCollect = 0
	local COLLECT_COOLDOWN = 1.5
	local collectDebounce = false

	do
		local claimPart = podium:FindFirstChild("Claim")
		if claimPart then
			local claimMain = claimPart:FindFirstChild("Main")
			if claimMain then
				local cashGui, cleanCash = FastOverhead.createFastOverhead({
					adornee = claimMain,
					guiTemplate = FastOverhead.GuiTemplates.CashPad,
				})
				collector:Add(cleanCash)
				local offlineLabel = cashGui:FindFirstChild("Offline", true)
				if offlineLabel then offlineLabel.Visible = false end
				collectLabel = cashGui:FindFirstChild("CollectAmount") or cashGui:FindFirstChild("Collect")

				local timerConn = Timer.Simple(1, function()
					if not cashGui or not cashGui.Parent then return end
					local elapsed = Workspace:GetServerTimeNow() - collectedAt
					local accumulated = math.ceil(math.floor(elapsed) * select(2, GetGeneration(animalIndex, mutation, traits)) * getMultiplier())
					if collectLabel then collectLabel.Text = ("$%s"):format(NumberUtils:ToString(accumulated)) end
					if offlineLabel then offlineLabel.Visible = false end
					cashGui.Enabled = true
				end, true)
				collector:Add(timerConn)

				local touchConn = claimMain.Touched:Connect(function(hit)
					if collectDebounce then return end
					local char = LocalPlayer.Character
					if not char then return end
					local now = tick()
					if now - lastCollect < COLLECT_COOLDOWN then return end
					if not collectLabel or collectLabel.Text == "$0" then return end
					for _, part in ipairs(char:GetChildren()) do
						if part == hit then
							collectDebounce = true
							lastCollect = now
							local elapsed = Workspace:GetServerTimeNow() - collectedAt
							local accumulated = math.ceil(math.floor(elapsed) * select(2, GetGeneration(animalIndex, mutation, traits)) * getMultiplier())
							DoMoney(accumulated)
							collectedAt = Workspace:GetServerTimeNow()
							if collectLabel then collectLabel.Text = "$0" end
							break
						end
					end
				end)
				collector:Add(touchConn)

				local touchEndedConn = claimMain.TouchEnded:Connect(function(hit)
					local char = LocalPlayer.Character
					if not char then return end
					for _, part in ipairs(char:GetChildren()) do
						if part == hit then collectDebounce = false; break end
					end
				end)
				collector:Add(touchEndedConn)
			end
		end
	end

	do
		local promptAttach = spawnPart:FindFirstChild("PromptAttachment")

		local prompt1 = AnimalPrompt.new(targetSlot, animalIndex, promptAttach, {
			UIOffset = Vector2.new(0, 0),
		})
		local prompt2 = AnimalPrompt.new(targetSlot, animalIndex, promptAttach, {
			KeyboardKeyCode = Enum.KeyCode.F,
			GamepadKeyCode = Enum.KeyCode.ButtonY,
			UIOffset = Vector2.new(0, -72),
		})
		prompt1:SetState("Grab")
		prompt2:SetState("Sell")

		local isGrabbing = false
		local grabCollector = nil
		local swapConnCollector = nil
		local handModel = nil

		local function setModelTransparency(transparent)
			for _, part in cloneModel:GetDescendants() do
				if part:IsA("BasePart") then
					local default = part:GetAttribute("DefaultTransparency")
					if default == nil then
						local tmplCache = modelCache[animalIndex]
						if tmplCache then
							for _, tp in tmplCache:GetDescendants() do
								if tp:IsA("BasePart") and tp.Name == part.Name then
									default = tp.Transparency
									break
								end
							end
						end
						default = default or part.Transparency
						part:SetAttribute("DefaultTransparency", default)
					end
					if transparent then
						if part.Transparency < 1 then
							part.Transparency = 0.5
						end
					else
						part.Transparency = default
					end
				end
			end
		end

		local function setOverheadVisible(state)
			if not overhead then return end
			overhead.DisplayName.Visible = state
			overhead.Rarity.Visible = state
			overhead.Price.Visible = state
			overhead.Mutation.Visible = state
		end

		local function resetCollect()
			collectedAt = Workspace:GetServerTimeNow()
			lastCollect = tick()
			if collectLabel then collectLabel.Text = "$0" end
		end

		local function sellCallback()
			local rarity = animalData.Rarity or ""
			local needsConfirm = rarity == "Mythic" or rarity == "Brainrot God" or rarity == "Secret" or rarity == "OG"
			if needsConfirm then
				SellConfirmation(targetSlot, resolvedDisplayName, function()
					DoMoney(animalData.Price / 2)
					clearFake(targetSlot)
				end, nil)
			else
				DoMoney(animalData.Price / 2)
				clearFake(targetSlot)
			end
		end

		local function notifyOtherFakes(grabbing)
			for slot, _ in pairs(fakeCollectors) do
				if slot ~= targetSlot then
					local slotPodium = myPlotModel.AnimalPodiums:FindFirstChild(slot)
					if slotPodium then
						local slotSpawn = slotPodium.Base.Spawn
						local slotPromptAttach = slotSpawn:FindFirstChild("PromptAttachment")
						if slotPromptAttach then
							for _, pp in slotPromptAttach:GetChildren() do
								if pp:IsA("ProximityPrompt") then
									local state = pp:GetAttribute("State")
									if grabbing then
										if state == "Sell" then pp.Enabled = false
										elseif state == "Grab" then pp:SetAttribute("State", "Place"); pp.ActionText = "Place" end
									else
										if state == "Place" then
											pp:SetAttribute("State", "Grab"); pp.ActionText = "Grab"; pp.Enabled = true
										elseif not pp.Enabled and state == "Sell" then
											pp.Enabled = true
										end
									end
								end
							end
						end
					end
				end
			end
		end

		local function getEmptySlotPodiums()
			local maxSlots = getMaxSlots()
			local list = getAnimalList()
			local empty = {}
			for i = 1, maxSlots do
				if not fakeCollectors[i] and not slotIsUntouchedReal(list[i]) then
					local ep = myPlotModel.AnimalPodiums:FindFirstChild(i)
					if ep then table.insert(empty, { slot = i, podium = ep }) end
				end
			end
			return empty
		end

		local function clearEmptyPrompts() clearActiveEmptyPrompts(targetSlot) end

		local function createEmptyPlacePrompts()
			clearEmptyPrompts()
			activeEmptyPrompts[targetSlot] = {}
			for _, data in getEmptySlotPodiums() do
				local ep = data.podium.Base.Spawn:FindFirstChild("PromptAttachment")
				if ep then
					local pp = Instance.new("ProximityPrompt")
					pp.ActionText = "Place"
					pp.ObjectText = ""
					pp.HoldDuration = 1.5
					pp.RequiresLineOfSight = true
					pp.Style = Enum.ProximityPromptStyle.Custom
					pp.KeyboardKeyCode = Enum.KeyCode.E
					pp.Parent = ep
					pp:SetAttribute("State", "Place")
					local emptySlot = data.slot
					pp.Triggered:Connect(function()
						if not isGrabbing then pp:Destroy(); return end
						local targetPodium = myPlotModel.AnimalPodiums:FindFirstChild(emptySlot)
						if not targetPodium then return end
						swappingInProgress = true
						if grabCollector then grabCollector:Clean(); grabCollector = nil end
						if handModel then handModel:Destroy(); handModel = nil end
						if swapConnCollector then swapConnCollector:Clean(); swapConnCollector = nil end
						isGrabbing = false
						LocalPlayer:SetAttribute("Stealing", false)
						fakeCollectors[targetSlot]:Clean()
						fakeCollectors[targetSlot] = nil
						fakeAnimalData[targetSlot] = nil
						notifyOtherFakes(false)
						clearEmptyPrompts()
						task.defer(function()
							swappingInProgress = false
							spawnAnimalOnPlot(animalIndex, mutation, traits, emptySlot)
						end)
					end)
					table.insert(activeEmptyPrompts[targetSlot], pp)
				end
			end
		end

		local function stopGrab()
			if not isGrabbing then return end
			isGrabbing = false
			if grabCollector then grabCollector:Clean(); grabCollector = nil end
			if swapConnCollector then swapConnCollector:Clean(); swapConnCollector = nil end
			if handModel then handModel:Destroy(); handModel = nil end
			LocalPlayer:SetAttribute("Stealing", false)
			if cloneModel and cloneModel.Parent then
				cloneModel.PrimaryPart.Anchored = true
				cloneModel:PivotTo(spawnPivot)
				restoreModelTransparency(cloneModel, animalIndex)
				setOverheadVisible(true)
			end
			resetCollect()
			prompt1:SetState("Grab")
			prompt1.ProximityPrompt.Enabled = true
			prompt2.ProximityPrompt.Enabled = true
			prompt2:SetCallback(sellCallback)
			prompt2:SetState("Sell")
			notifyOtherFakes(false)
			clearEmptyPrompts()
		end

		collector:Add(LocalPlayer.CharacterRemoving:Connect(function()
			if isGrabbing then stopGrab() end
		end))
		collector:Add(LocalPlayer:GetAttributeChangedSignal("RagdollEndTime"):Connect(function()
			if isGrabbing then stopGrab() end
		end))

		prompt2:SetCallback(sellCallback)

		prompt1:SetCallback(function()
			if swappingInProgress then return end
			if isGrabbing then stopGrab(); return end
			local char = LocalPlayer.Character
			if not char then return end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local humanoid = char:FindFirstChild("Humanoid")
			if not hrp or not humanoid then return end

			isGrabbing = true
			LocalPlayer:SetAttribute("Stealing", true)
			humanoid:UnequipTools()
			setOverheadVisible(false)
			setModelTransparency(true)
			prompt1:SetState("Place")
			prompt2.ProximityPrompt.Enabled = false
			notifyOtherFakes(true)
			createEmptyPlacePrompts()

			swapConnCollector = Trove.new()
			for slot, _ in pairs(fakeCollectors) do
				if slot ~= targetSlot then
					local otherPodium = myPlotModel.AnimalPodiums:FindFirstChild(slot)
					if otherPodium then
						local otherAttach = otherPodium.Base.Spawn:FindFirstChild("PromptAttachment")
						if otherAttach then
							for _, pp in otherAttach:GetChildren() do
								if pp:IsA("ProximityPrompt") and pp:GetAttribute("State") == "Place" then
									local otherSlot = slot
									swapConnCollector:Add(pp.Triggered:Connect(function()
										if not isGrabbing then return end
										local myOldSlot = targetSlot
										local otherSlotData = fakeAnimalData[otherSlot]
										if not otherSlotData then return end
										local otherIndex = otherSlotData.Index
										local otherMutation = otherSlotData.Mutation
										local otherTraits = otherSlotData.Traits
										swappingInProgress = true
										if grabCollector then grabCollector:Clean(); grabCollector = nil end
										if handModel then handModel:Destroy(); handModel = nil end
										if swapConnCollector then swapConnCollector:Clean(); swapConnCollector = nil end
										isGrabbing = false
										LocalPlayer:SetAttribute("Stealing", false)
										fakeCollectors[myOldSlot]:Clean()
										fakeCollectors[myOldSlot] = nil
										fakeAnimalData[myOldSlot] = nil
										fakeCollectors[otherSlot]:Clean()
										fakeCollectors[otherSlot] = nil
										fakeAnimalData[otherSlot] = nil
										notifyOtherFakes(false)
										clearEmptyPrompts()
										task.defer(function()
											swappingInProgress = false
											spawnAnimalOnPlot(animalIndex, mutation, traits, otherSlot)
											spawnAnimalOnPlot(otherIndex, otherMutation, otherTraits, myOldSlot)
										end)
									end))
								end
							end
						end
					end
				end
			end

			grabCollector = Trove.new()
			local grabAnim = Instance.new("Animation")
			grabAnim.AnimationId = "rbxassetid://71186871415348"
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if animator then
				local holdTrack = grabCollector:Add(animator:LoadAnimation(grabAnim))
				holdTrack.Looped = true
				holdTrack:Play()
				grabCollector:Add(function() holdTrack:Stop(0) end)
			end

			handModel = modelTemplate:Clone()

			for _, part in handModel:GetDescendants() do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
					part.Massless = true
					part.Anchored = false
				end
				if part:IsA("Script") or part:IsA("LocalScript") then part:Destroy() end
			end

			if mutation then SharedAnimals:ApplyMutation(handModel, animalIndex, mutation) end
			if traits and #traits > 0 then SharedAnimals:ApplyTraits(handModel, animalIndex, traits) end

			restoreModelTransparency(handModel, animalIndex)

			do
				local existingHandAC = handModel:FindFirstChild("AnimationController")
				if existingHandAC then existingHandAC:Destroy() end
				local handHum = Instance.new("Humanoid", handModel)
				Instance.new("Animator", handHum)
				handHum.Name = "AnimationController"
				handHum.EvaluateStateMachine = false
				handHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				handHum.PlatformStand = true
				local handAnimator = handHum:FindFirstChildOfClass("Animator")
				local handIdleAnim = AnimFolder:FindFirstChild(animalIndex)
				handIdleAnim = handIdleAnim and handIdleAnim:FindFirstChild("Idle")
				if handIdleAnim and handAnimator then
					local handTrack = handAnimator:LoadAnimation(handIdleAnim)
					handTrack.Looped = true
					handTrack:Play()
					local handUnsync = AnimSync:Add(handTrack)
					grabCollector:Add(function()
						handUnsync()
						handTrack:Stop(0)
						handTrack:Destroy()
					end)
				end
			end

			handModel.Parent = Workspace
			local handPrimary = handModel.PrimaryPart
			local weld = grabCollector:Add(Instance.new("Weld"))
			weld.Name = "FakeGrabWeld"
			weld.Part0 = handPrimary
			weld.Part1 = hrp
			weld.C0 = handPrimary.PivotOffset
			weld.C1 = CFrame.new(0, 0.25, -2.25)
			weld.Parent = handPrimary

			local moveConn = RunService.Heartbeat:Connect(function()
				if not isGrabbing then return end
				local c = LocalPlayer.Character
				if not c then return end
				local h = c:FindFirstChild("Humanoid")
				local root = c:FindFirstChild("HumanoidRootPart")
				if not h or not root then return end
				local dir = h.MoveDirection
				root.Velocity = Vector3.new(dir.X * 20.4, root.Velocity.Y, dir.Z * 20.4)
			end)
			grabCollector:Add(moveConn)
			grabCollector:Add(function()
				if handModel then handModel:Destroy(); handModel = nil end
			end)
		end)

		collector:Add(prompt1.ProximityPrompt.PromptButtonHoldBegan:Connect(function()
			prompt2.ProximityPrompt.Enabled = false
		end))
		collector:Add(prompt1.ProximityPrompt.PromptButtonHoldEnded:Connect(function()
			if not isGrabbing then prompt2.ProximityPrompt.Enabled = true; prompt2:SetState(prompt2.State) end
		end))
		collector:Add(prompt2.ProximityPrompt.PromptButtonHoldBegan:Connect(function()
			prompt1.ProximityPrompt.Enabled = false
		end))
		collector:Add(prompt2.ProximityPrompt.PromptButtonHoldEnded:Connect(function()
			if not isGrabbing then prompt1.ProximityPrompt.Enabled = true; prompt1:SetState(prompt1.State) end
		end))
		collector:Add(function()
			if isGrabbing then stopGrab() end
			clearActiveEmptyPrompts(targetSlot)
		end)
		collector:Add(prompt1)
		collector:Add(prompt2)
	end

	return true, targetSlot
end

do
	local plotCF, plotSize = myPlotModel:GetBoundingBox()
	local halfSize = plotSize / 2

	local function isInsidePlot(pos)
		local local_ = plotCF:PointToObjectSpace(pos)
		return math.abs(local_.X) <= halfSize.X
			and math.abs(local_.Y) <= halfSize.Y
			and math.abs(local_.Z) <= halfSize.Z
	end

	local function getOverheadGui(part)
		return part:FindFirstChildWhichIsA("SurfaceGui")
			or part:FindFirstChildWhichIsA("BillboardGui")
	end

	local function isAnimalOverheadPart(part)
		local gui = getOverheadGui(part)
		if not gui then return false end
		return gui:FindFirstChild("DisplayName") ~= nil and gui:FindFirstChild("Rarity") ~= nil
	end

	local function isCashPadPart(part)
		local gui = getOverheadGui(part)
		if not gui then return false end
		if gui:FindFirstChild("DisplayName") then return false end
		return gui:FindFirstChild("Collect") ~= nil or gui:FindFirstChild("CollectAmount") ~= nil
	end

	local podiumsFolder = myPlotModel:FindFirstChild("AnimalPodiums")

	local function findNearestPodium(pos, anchorKind, maxDist)
		if not podiumsFolder then return nil end
		local bestSlot, bestDist
		for _, podium in ipairs(podiumsFolder:GetChildren()) do
			local slotNum = tonumber(podium.Name)
			if slotNum then
				local anchor
				if anchorKind == "Spawn" then
					local base = podium:FindFirstChild("Base")
					anchor = base and base:FindFirstChild("Spawn")
				elseif anchorKind == "ClaimMain" then
					local claim = podium:FindFirstChild("Claim")
					anchor = claim and claim:FindFirstChild("Main")
				end
				if anchor then
					local dist = (anchor.Position - pos).Magnitude
					if not bestDist or dist < bestDist then
						bestDist = dist
						bestSlot = slotNum
					end
				end
			end
		end
		if bestDist and bestDist <= maxDist then
			return bestSlot
		end
		return nil
	end

	local debris = Workspace:FindFirstChild("Debris")
	if debris then
		local list = getAnimalList()
		for _, child in ipairs(debris:GetChildren()) do
			if not child:GetAttribute("Fake") then
				local isAO = isAnimalOverheadPart(child)
				local isCP = (not isAO) and isCashPadPart(child)
				if isAO or isCP then
					local ok, pivot = pcall(function() return child:GetPivot() end)
					if ok and pivot.Position.Y < 9000 and isInsidePlot(pivot.Position) then
						local slot
						if isAO then
							slot = findNearestPodium(pivot.Position, "Spawn", 20)
						else
							slot = findNearestPodium(pivot.Position, "ClaimMain", 4)
						end
						local entry = slot and list[slot]
						if slotHasRealAnimal(entry) and TargetBrainrots[entry.Index] then
							child:Destroy()
						end
					end
				end
			end
		end
	end

	local maxSlots = getMaxSlots()

	local function doInitialSpawn()
		local list = getAnimalList()
		local toSpawn = {}

		local hasAnyTarget = false
		for slot = 1, maxSlots do
			local entry = list[slot]
			if slotHasRealAnimal(entry) and TargetBrainrots[entry.Index] then
				hasAnyTarget = true
				break
			end
		end

		if hasAnyTarget then
			for slot = 1, maxSlots do
				local entry = list[slot]
				if slotHasRealAnimal(entry) and not fakeCollectors[slot] then
					table.insert(toSpawn, {entry.Index, entry.Mutation, entry.Traits, slot})
				end
			end
			for _, child in ipairs(myPlotModel:GetChildren()) do
				if child:IsA("Model") and AnimalsData[child.Name] then
					child:Destroy()
				end
			end
			for _, args in ipairs(toSpawn) do
				spawnAnimalOnPlot(args[1], args[2], args[3], args[4])
			end
		end

		return hasAnyTarget
	end

	-- Spawn initial
	task.defer(doInitialSpawn)

	-- Surveiller l'apparition d'un TargetBrainrot dans la base
	local visualsActive = false
	task.spawn(function()
		while task.wait(1) do
			local list = getAnimalList()
			local hasTarget = false
			for slot = 1, maxSlots do
				local entry = list[slot]
				if slotHasRealAnimal(entry) and TargetBrainrots[entry.Index] then
					hasTarget = true
					break
				end
			end

			if hasTarget and not visualsActive then
				-- Un TargetBrainrot vient d'apparaître, spawner les visuels
				visualsActive = true
				for slot = 1, maxSlots do
					local entry = list[slot]
					if slotHasRealAnimal(entry) and not fakeCollectors[slot] then
						local child = myPlotModel:FindFirstChild(entry.Index)
						if child and child:IsA("Model") then child:Destroy() end
						spawnAnimalOnPlot(entry.Index, entry.Mutation, entry.Traits, slot)
					end
				end
			elseif not hasTarget then
				visualsActive = false
			end
		end
	end)
end
