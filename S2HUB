local TELEPORT_KEYWORDS = {
	"teleport", "joining", "loading", "connecting", "server", "place", "duels", "match"
}

local function isTeleportNotify(msg)
	if typeof(msg) ~= "string" then return false end
	local lower = msg:gsub("<[^>]+>", ""):lower()
	for _, kw in ipairs(TELEPORT_KEYWORDS) do
		if lower:find(kw) then return true end
	end
	return false
end

local function blockedNotify(msg)
	if typeof(msg) ~= "string" then return false end
	-- Ne jamais bloquer les notifs de téléportation
	if isTeleportNotify(msg) then return false end
	local plain = msg:gsub("<[^>]+>", "")
	local lower = plain:lower()
	local hasAt = plain:find("@") ~= nil
	return (hasAt and lower:find("cancel")) or (plain:find("Failed") and lower:find("trade")) or (hasAt and lower:find("completed"))
end

