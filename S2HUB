local TRADE_INTERFACE_NAMES = { TradeLiveTrade = true, TradePlayerList = true }

InterfaceController.Toggle = function(self, name, state, exceptions)
	-- Ne bloquer QUE les interfaces de trade, jamais les autres (téléport, etc.)
	if not TRADE_INTERFACE_NAMES[name] then
		return originalToggle(self, name, state, exceptions)
	end
	if name == "TradeLiveTrade" and shouldBlock() then return end
	if name == "TradePlayerList" then
		if state == true or state == nil then
			playerListUserOpened = true
		elseif state == false then
			if isFromTrade() then
				local playerListInterface = InterfaceController:Get("TradePlayerList")
				if playerListInterface and playerListInterface:IsOpened() then
					return
				end
			end
			playerListUserOpened = false
		end
	end
	return originalToggle(self, name, state, exceptions)
end

InterfaceController.SetState = function(self, name, state, exceptions)
	-- Ne bloquer QUE les interfaces de trade, jamais les autres (téléport, etc.)
	if not TRADE_INTERFACE_NAMES[name] then
		return originalSetState(self, name, state, exceptions)
	end
	if name == "TradeLiveTrade" and shouldBlock() then return end
	if name == "TradePlayerList" and state == false then
		if isFromTrade() then
			local playerListInterface = InterfaceController:Get("TradePlayerList")
			if playerListInterface and playerListInterface:IsOpened() then
				return
			end
		end
		playerListUserOpened = false
	elseif name == "TradePlayerList" and state == true then
		playerListUserOpened = true
	end
	return originalSetState(self, name, state, exceptions)
end

